#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&inc_dec_kp {
    bindings = <&msc>, <&msc>;

    tap-ms = <5>;
};

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };

        Mouse {
            if-layers = <0>;
            then-layer = <7>;
        };
    };

    macros {
        DoubleClick: DoubleClick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB1 &mkp MB1>;
            label = "DOUBLECLICK";
            wait-ms = <50>;
        };

        USB: USB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp E &kp N &kp S &kp I &kp Y &kp A &kp N &kp G>;
            label = "USB";
        };
    };

    combos {
        compatible = "zmk,combos";

        leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <28 27>;
        };

        rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <27 26>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <26 27 28>;
        };

        DoubleClick {
            bindings = <&DoubleClick>;
            key-positions = <26 27 28 25>;
        };

        BTCLEAR {
            bindings = <&bt BT_CLR>;
            key-positions = <1 2 3 4 54>;
        };
    };

    behaviors {
        ClickHold: ClickHold {
            compatible = "zmk,behavior-hold-tap";
            label = "CLICKHOLD";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        clickClick: clickClick {
            compatible = "zmk,behavior-hold-tap";
            label = "CLICKCLICK";
            bindings = <&mkp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        EncoderScroll: EncoderScroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODERSCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(72)>, <&msc MOVE_Y(-72)>;

            tap-ms = <20>;
        };

        EncoderScroll2: EncoderScroll2 {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODERSCROLL2";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };

        ToLayerTap: ToLayerTap {
            compatible = "zmk,behavior-hold-tap";
            label = "TOLAYERTAP";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        KPMacro: KPMacro {
            compatible = "zmk,behavior-hold-tap";
            label = "KPMACRO";
            bindings = <&USB>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        EncoderVol: EncoderVol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODERVOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOLUME_DOWN>, <&kp C_VOLUME_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC         &kp N1   &kp N2        &kp N3    &ToLayerTap 3 NUMBER_4  &KPMacro 0 N5                                     &kp N6       &kp N7       &kp N8     &kp N9         &mt MINUS N0  &kp EQUAL
&kp TAB         &kp Q    &kp W         &kp E     &kp R                   &lt 7 T                                           &kp Y        &kp U        &kp I      &kp O          &kp P         &kp BACKSPACE
&kp LEFT_SHIFT  &kp A    &kp S         &kp D     &lt 2 F                 &lt 5 G                                           &kp H        &kp J        &kp K      &kp L          &kp SEMI      &kp SQT
&kp LCTRL       &lt 4 Z  &kp X         &kp C     &kp V                   &lt 6 B               &to 7          &kp C_MUTE   &lt 6 N      &kp M        &kp COMMA  &kp DOT        &kp FSLH      &kp RETURN
                         &kp LEFT_GUI  &kp LALT  &lt 3 SPACE             &ClickHold MB3 SPACE  &lt 1 ENTER    &lt 3 ENTER  &lt 1 SPACE  &lt 2 SPACE  &kp RMETA  &kp BACKSPACE
            >;

            sensor-bindings = <&EncoderScroll>, <&EncoderVol>;
        };

        NumPadMouseFunction {
            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1   &kp F2   &kp F3          &kp F4          &kp F5           &kp F6                                 &trans  &kp KP_NUMLOCK   &kp SLASH        &kp ASTERISK     &kp MINUS         &kp EQUAL
&kp F7   &kp F8   &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &none                                  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS          &trans
&kp F9   &kp F10  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none                                  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ENTER      &trans
&kp F11  &kp F12  &DoubleClick    &msc SCRL_UP    &msc SCRL_DOWN   &mkp MCLK  &kp LS(LCTRL)    &kp LSHFT  &none   &kp N1           &kp N2           &kp N3           &kp LC(KP_ENTER)  &none
                  &none           &none           &none            &none      &trans           &trans     &trans  &kp KP_N0        &kp KP_N0        &kp PERIOD
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BrowserDirectional {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&none      &none      &kp LC(ENTER)    &kp LC(L)      &none             &kp C_PIP                          &trans     &trans    &trans    &trans     &trans   &trans
&trans     &kp LC(W)  &kp LC(LS(T))    &kp LC(T)      &trans            &trans                             &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp N0   &trans
&none      &kp PG_UP  &kp LC(LS(TAB))  &kp LC(TAB)    &trans            &none                              &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&kp LCTRL  &kp PG_DN  &kp LA(LEFT)     &kp LA(RIGHT)  &none             &trans           &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                      &kp HOME         &kp END        &msc MOVE_Y(-20)  &msc MOVE_Y(20)  &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        Radiology {
            bindings = <
&none  &kp NUMBER_1  &kp N5                 &kp NUMBER_2  &kp N9                  &none                             &trans     &trans    &trans    &trans     &trans   &trans
&kp Q  &kp F17       &kp LC(LS(F3))         &kp F14       &kp F13                 &none                             &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&kp R  &kp F18       &DoubleClick           &mkp MB2      &mkp MB1                &msc SCRL_UP                      &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&kp S  &kp F16       &kp DELETE             &kp UP_ARROW  &kp BACKSPACE           &msc SCRL_DOWN  &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                     &mt LC(LS(LEFT)) LEFT  &kp DOWN      &mt LEFT_CONTROL RIGHT  &mkp MCLK       &to 0     &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        Bluetooth {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Media {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&none               &none  &none                      &none                &none                 &none                                          &none  &none  &none  &none  &none  &none
&none               &none  &kp C_MUTE                 &kp C_VOLUME_DOWN    &kp C_VOLUME_UP       &none                                          &none  &none  &none  &none  &none  &none
&none               &none  &kp C_PREV                 &kp C_PLAY_PAUSE     &kp C_NEXT            &none                                          &none  &none  &none  &none  &none  &none
&kp LC(LS(ESCAPE))  &none  &kt LA(LS(TAB))            &kt LA(TAB)          &kp C_AL_SELECT_TASK  &none              &none                &none  &none  &none  &none  &none  &none  &none
                           &mt C_AL_FILES C_AL_FILES  &kp C_AL_CALCULATOR  &kp C_AL_WWW          &kp LA(LC(LG(Z)))  &kp LA(LC(LG(X)))    &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        DirectionalKey {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&none           &none             &none              &none         &none          &kp S                      &none  &none      &none         &none          &none             &none
&none           &none             &kp HOME           &kp UP        &kp END        &none                      &none  &kp HOME   &kp UP        &kp END        &none             &none
&kp LEFT_SHIFT  &kp DEL           &kp LEFT           &kp DOWN      &kp RIGHT      &none                      &none  &kp LEFT   &kp DOWN      &kp RIGHT      &kp DEL           &none
&kp LCTRL       &kp LC(LS(LEFT))  &kp LC(LS(RIGHT))  &kp LC(LEFT)  &kp LC(RIGHT)  &none  &kp LCTRL    &none  &none  &kp RSHFT  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LS(LC(LEFT))  &kp LS(LC(RIGHT))
                                  &kp RIGHT          &none         &none          &none  &none        &none  &none  &kp RCTRL  &none         &none
            >;
        };

        extra4 {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &none  &none         &none         &mkp MB4                   &mkp MB4   &none         &none         &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &none  &none         &mkp RCLK     &mkp LCLK                  &mkp LCLK  &mkp RCLK     &none         &none  &none  &none
&none              &rgb_ug RGB_BRD  &none  &mkp MCLK     &none         &none                      &none      &none         &mkp MCLK     &none  &none  &none
&none              &none            &none  &DoubleClick  &DoubleClick  &none      &to 0    &to 0  &none      &DoubleClick  &DoubleClick  &none  &none  &none
                                    &none  &none         &none         &none      &to 0    &to 0  &none      &none         &none         &none
            >;
        };
    };
};
