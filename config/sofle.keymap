#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    macros {
        DoubleClick: DoubleClick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp MB1 &mkp MB1>;
            label = "DOUBLECLICK";
            wait-ms = <50>;
        };

        MiddleClick: MiddleClick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "MIDDLECLICK";
        };
    };

    combos {
        compatible = "zmk,combos";

        leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <28 27>;
        };

        rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <27 26>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <26 27 28>;
        };

        DoubleClick {
            bindings = <&DoubleClick>;
            key-positions = <26 27 28 25>;
        };
    };

    behaviors {
        ClickHold: ClickHold {
            compatible = "zmk,behavior-hold-tap";
            label = "CLICKHOLD";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        clickClick: clickClick {
            compatible = "zmk,behavior-hold-tap";
            label = "CLICKCLICK";
            bindings = <&mkp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        EncoderScroll: EncoderScroll {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODERSCROLL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC         &kp N1  &kp N2        &kp N3    &kp N4   &kp N5                                                   &kp N6     &kp N7         &kp N8      &mt N9 MINUS  &mt N0 EQUAL  &kp MINUS
&kp TAB         &kp Q   &kp W         &kp E     &kp R    &kp T                                                    &kp Y      &kp U          &kp I       &kp O         &kp P         &kp BACKSPACE
&kp LEFT_SHIFT  &kp A   &kp S         &kp D     &lt 2 F  &lt 5 G                                                  &kp H      &kp J          &kp K       &kp L         &kp SEMI      &kp ENTER
&kp LCTRL       &kp Z   &kp X         &kp C     &kp V    &kp B                 &lt 4 C_PLAY_PAUSE    &kp C_MUTE   &kp N      &kp M          &kp COMMA   &kp DOT       &kp FSLH      &kp SQT
                        &kp LEFT_GUI  &kp LALT  &to 3    &ClickHold MB3 SPACE  &lt 1 ENTER           &lt 3 ENTER  &kp SPACE  &kp BACKSPACE  &kp DELETE  &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        NumPad {
            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans  &kp KP_NUMLOCK   &kp SLASH        &kp ASTERISK     &kp MINUS     &kp EQUAL
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &trans
&trans  &trans  &trans  &trans   &trans   &trans                     &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ENTER  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans  &kp KP_N1        &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER  &trans
                &trans  &trans   &trans   &trans   &trans    &trans  &trans  &kp KP_N0        &kp KP_N0        &kp PERIOD
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Browser {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&none      &none      &kp LC(ENTER)    &kp LC(L)      &none         &kp C_PIP                         &trans     &trans    &trans    &trans     &trans   &trans
&trans     &kp LC(W)  &kp LC(LS(T))    &kp LC(T)      &trans        &trans                            &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp N0   &trans
&none      &kp PG_UP  &kp LC(LS(TAB))  &kp LC(TAB)    &trans        &none                             &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&kp LCTRL  &kp PG_DN  &kp LA(LEFT)     &kp LA(RIGHT)  &none         &trans          &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                      &kp HOME         &kp END        &msc SCRL_UP  &msc SCRL_DOWN  &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        Radiology {
            bindings = <
&none  &kp NUMBER_1  &kp NUMBER_2           &kp N5        &kp NUMBER_3           &none                             &trans     &trans    &trans    &trans     &trans   &trans
&none  &kp F17       &kp F3                 &kp F14       &kp F13                &none                             &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &trans
&none  &kp F18       &DoubleClick           &mkp MB2      &mkp MB1               &msc SCRL_UP                      &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&none  &kp F16       &kp DELETE             &kp UP_ARROW  &kp BACKSPACE          &msc SCRL_DOWN  &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                     &mt LC(LS(LEFT)) LEFT  &kp DOWN      &ClickHold MCLK RIGHT  &kp LCTRL       &to 0     &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        Bluetooth {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Media {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&none  &none  &none       &none             &none            &none                                          &none  &none  &none  &none  &none  &none
&none  &none  &kp C_MUTE  &kp C_VOL_UP      &kp C_VOL_DN     &none                                          &none  &none  &none  &none  &none  &none
&none  &none  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT       &none                                          &none  &none  &none  &none  &none  &none
&none  &none  &none       &kp C_REWIND      &kp C_FF         &none              &none                &none  &none  &none  &none  &none  &none  &none
              &none       &none             &kp C_MEDIA_WWW  &kp LA(LC(LG(Z)))  &kp LA(LC(LG(X)))    &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        extra3 {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;
        };

        extra4 {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                     &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                  &none  &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                            &none  &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &none    &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none    &none  &none  &none  &none  &none
            >;
        };
    };
};
